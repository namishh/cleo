OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: stronger/pricier model for one-shot task compilation (runs once per
# task, not once per step). Falls back to OPENROUTER_MODEL if unset.
OPENROUTER_COMPILATION_MODEL=
# Shared token the extension must send as "Authorization: Bearer <token>".
# Defaults to 9876543210 if unset — change it if this backend is reachable
# beyond your own machine.
CLEO_AUTH_TOKEN=
